# ========================================================
# RPMC CONFIGURATION TEMPLATE (.env.example)
# ========================================================

# Token bảo mật (Tối thiểu 16 ký tự; chạy 'python rpmc.py init' để tự sinh token ngẫu nhiên)
RPMC_ADMIN_TOKEN=AdminTokenNgauNhien32KyTu
RPMC_AGENT_TOKEN=AgentTokenNgauNhien32KyTu

# Cổng TCP Socket điều khiển (Giám thị SM / Agent máy con)
RPMC_SERVER_PORT=8090

# Cổng Web Server bài thi thí sinh
EXAM_HTTP_PORT=8081

# Cổng Web Server biên soạn đề thi từ Word
EXAM_EDITOR_PORT=8082

# Cấu hình mạng LAN
RPMC_BIND_HOST=0.0.0.0
RPMC_ALLOW_PRIVATE_NETWORK=1

# Cấu hình cho Agent thí sinh / máy con kết nối về server
RPMC_SERVER_HOST=127.0.0.1
RPMC_CLIENT_ID=PC01
RPMC_ALLOW_PROCESS_TERMINATION=1

# Kết nối cơ sở dữ liệu PostgreSQL (Lưu ngân hàng câu hỏi, bài thi, vi phạm)
# Chú ý: Nếu mật khẩu có ký tự đặc biệt (@, #, $), cần URL-encode (vd: @ -> %40)
RPMC_DB_DSN=postgresql://postgres:matkhau@localhost:5432/rpmc
RPMC_TEST_DSN=postgresql://postgres:matkhau@localhost:5432/rpmc_test
